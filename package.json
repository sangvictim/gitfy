{
  "name": "gitfy",
  "productName": "Gitfy",
  "version": "0.0.2",
  "description": "Lightweight cross-platform Git GUI client",
  "author": "Setyo Purnomo <sangvictim@gmail.com>",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "bun run typecheck && vite build && electron-builder",
    "build:dir": "bun run typecheck && vite build && electron-builder --dir",
    "build:linux": "bun run typecheck && vite build && electron-builder --linux",
    "build:win": "bun run typecheck && vite build && electron-builder --win --x64",
    "build:mac": "bun run typecheck && vite build && electron-builder --mac --arm64"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-git": "^4.0.2",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "zustand": "^5.0.16"
  }
}